proc sgpanel data=Nugget;
panelby Year/layout=columnlattice columns=3;
scatter x=treatment y=_alpha/group=Block;
run;

proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model DM=Treatment/dist=normal;
*random Block; *Block effect covariance estimate was 0 for all years;
lsmeans Treatment/lines;
run;

proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model _alpha=Treatment/dist=normal;
*random Block;
lsmeans Treatment/lines;
run;
proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model _alpha=Treatment/dist=normal;
random Block;
lsmeans Treatment/lines;
run;
proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model HSI=Treatment/dist=normal;
random Block;
lsmeans Treatment/lines;
run;
proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model Oil=Treatment/dist=normal;
random Block;
lsmeans Treatment/lines;
run;
proc glimmix plots=residualpanel data=Nugget;
by Year;
class Block Treatment;
model Color=Treatment/dist=normal;
*random Block; *block effect was 0;
lsmeans Treatment/lines;
run;

*IPD meta-analysis code for this data set follows;
proc glimmix plots=residualpanel data=Nugget;
class Year Block Treatment;
model DM=Treatment/dist=normal;
random Year;* Year*Treatment Block(Year) removed due to 0 covariance parameter estimates;
lsmeans Treatment/lines;
run;

proc glimmix plots=residualpanel data=Nugget;
class Year Block Treatment;
model _Alpha=Treatment/dist=normal;
random Year Year*Treatment;* block(year);
lsmeans Treatment/lines;
run;

proc glimmix plots=residualpanel data=Nugget;
class Year Block Treatment;
model HSI=Treatment/dist=normal;
random Year Year*Treatment; *block(year);
lsmeans Treatment/lines;
run;

proc glimmix plots=residualpanel data=Nugget;
class Year Block Treatment;
model Color=Treatment/dist=normal;
random Year Year*Treatment;* block(year);
lsmeans Treatment/lines;
run;

